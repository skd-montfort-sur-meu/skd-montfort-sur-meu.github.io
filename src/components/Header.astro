---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { label: 'Accueil', href: `${base}` },
  { label: 'L\'art du Karaté', href: `${base}karate` },
  { label: 'Karaté Santé Seniors', href: `${base}karate-sante-seniors` },
  { label: 'Tarifs', href: `${base}#tarifs` },
  { label: 'Événements', href: `${base}evenements` },
  { label: 'Contact', href: `${base}#contact` },
  { label: 'Photos', href: `${base}photos` },
];
---
<header class="fixed top-0 left-0 right-0 z-50 bg-white">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={`${base}`} class="flex flex-col gap-0">
        <span class="text-2xl font-bold text-gray-900 tracking-tight leading-tight">
          <span class="text-red-600">Shotokan</span> Karaté-dō
        </span>
        <span class="text-xs text-gray-500 tracking-wide">Montfort-sur-Meu</span>
      </a>
      
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class="text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </div>

      <button 
        id="mobile-menu-btn"
        class="md:hidden text-gray-900 p-2"
        aria-label="Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="block py-2 text-gray-600 hover:text-gray-900 transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
