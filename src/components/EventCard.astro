---
import { Icon } from 'astro-icon/components';
import { eventPlace, eventSubline, nonEmpty } from '../lib/events';
import type { FormattedEvent, ClubEvent, EventCategory } from '../lib/events';

interface Props {
  event: FormattedEvent<ClubEvent>;
}

const { event } = Astro.props;

const categoryLabels: Record<EventCategory, string> = {
  competition: 'Compétition',
  stage: 'Stage',
  grade: 'Grade',
};

const badgeClasses: Record<EventCategory, string> = {
  competition: 'bg-red-100 text-red-700',
  stage: 'bg-gray-200 text-gray-700',
  grade: 'bg-amber-100 text-amber-700',
};

const subline = eventSubline(event);
const place = eventPlace(event);
const time = nonEmpty(event.time);
const price = nonEmpty(event.price);
---
<article class="bg-gray-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
  <div class="grid grid-cols-1 md:grid-cols-[120px_1fr]">
    <div class="bg-red-600 text-white flex flex-col items-center justify-center py-6 md:py-8">
      <span class="text-3xl font-bold">{event.day}</span>
      <span class="text-sm uppercase tracking-wide">{event.month}</span>
    </div>
    <div class="p-6 md:p-8">
      <div class="flex items-start gap-3 mb-3">
        <Icon name={event.icon!} class="w-6 h-6 text-red-600 flex-shrink-0 mt-0.5" />
        <div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900">{event.title}</h3>
          <span class:list={[
            'inline-block mt-1 text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full',
            badgeClasses[event.category],
          ]}>
            {categoryLabels[event.category]}
          </span>
        </div>
      </div>
      {subline && <p class="text-red-600 font-medium mb-4">{subline}</p>}
      <div class="space-y-2 text-gray-600">
        <p class="flex items-start gap-2">
          <Icon name="lucide:calendar-days" class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" />
          <span>{event.dateLabel}{time && <> — {time}</>}</span>
        </p>
        {place && (
          <p class="flex items-start gap-2">
            <Icon name="lucide:map-pin" class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" />
            <span>{place}</span>
          </p>
        )}
        {price && (
          <p class="flex items-start gap-2">
            <Icon name="lucide:ticket" class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" />
            <span>{price}</span>
          </p>
        )}
      </div>
    </div>
  </div>
</article>