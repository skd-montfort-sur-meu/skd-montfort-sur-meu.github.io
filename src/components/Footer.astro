---
import clubData from '../content/config/club.json';

const base = import.meta.env.BASE_URL;
---
<footer class="bg-gray-50 text-gray-600 py-12 border-t border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-gray-900 font-bold text-lg mb-4">
          <span class="text-red-600">Shotokan</span> Karaté-dō Montfort
        </h3>
        <p class="text-sm">
          {clubData.footerDescription}
        </p>
      </div>

      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}`} class="hover:text-gray-900 transition-colors">Accueil</a></li>
          <li><a href={`${base}karate`} class="hover:text-gray-900 transition-colors">Karaté</a></li>
          <li><a href={`${base}#tarifs`} class="hover:text-gray-900 transition-colors">Tarifs</a></li>
           <li><a href={`${base}evenements`} class="hover:text-gray-900 transition-colors">Événements</a></li>
          <li><a href={`${base}photos`} class="hover:text-gray-900 transition-colors">Photos</a></li>
          <li><a href={`${base}#contact`} class="hover:text-gray-900 transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Avec le soutien de</h4>
        <div class="flex flex-wrap items-center gap-6">
          <img
            src={`${base}images/Sport-Sante-Bretagne-Forme-Sante-Logo.png`}
            alt="Sport Santé Bretagne — Forme Santé"
            loading="lazy"
            decoding="async"
            class="max-w-[150px] max-h-16 w-auto object-contain"
          />
          <img
            src={`${base}images/FFKarate_H_COULEUR_PRINT.png`}
            alt="Fédération Française de Karaté"
            loading="lazy"
            decoding="async"
            class="max-w-[150px] max-h-16 w-auto object-contain"
          />
        </div>
      </div>

      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Contact</h4>
        <ul class="space-y-2 text-sm">
          {clubData.address.split(', ').map((line) => (
            <li>{line}</li>
          ))}
          <li class="pt-2">
            <a href={`mailto:${clubData.email}`} class="hover:text-gray-900 transition-colors">
              {clubData.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-8 text-center text-sm">
      <p>&copy; {new Date().getFullYear()} Shotokan Karaté Montfort. Tous droits réservés.</p>
    </div>
  </div>
</footer>
