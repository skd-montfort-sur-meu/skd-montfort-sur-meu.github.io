---
const base = import.meta.env.BASE_URL;
---
<section class="relative h-[40vh] min-h-[400px] md:h-screen md:max-h-[750px] md:min-h-[600px] pt-16 md:pt-0 flex items-center justify-center overflow-hidden">
  <div 
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style={`background-image: url('${base}images/hero.jpg')`}
  >
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-black/60"></div>
  </div>

  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-6 tracking-tight">
      <span class="text-red-600">Shotokan</span> Karaté-dō
    </h1>
    <p class="text-xl sm:text-2xl text-gray-200 mb-8 font-light">
      Montfort-sur-Meu
    </p>
    <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto italic">
      "Un esprit zen dans un corps sain"
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a 
        href={`${base}#contact`} 
        class="inline-block bg-red-600 hover:bg-red-700 text-white font-semibold px-8 py-3 rounded transition-colors duration-200"
      >
        Nous rejoindre
      </a>
      <a 
        href="#presentation" 
        class="inline-block border border-white/30 hover:border-white text-white font-semibold px-8 py-3 rounded transition-colors duration-200"
      >
        Découvrir le club
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
