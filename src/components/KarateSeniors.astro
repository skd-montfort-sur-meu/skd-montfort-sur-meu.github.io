---
import { Icon } from 'astro-icon/components';
import data from '../content/config/karate-seniors.json';

const base = import.meta.env.BASE_URL;
const { hero, benefits, details, teacher, cta } = data;
---
<div class="pt-16">
  <section class="bg-gray-900 text-white py-24 text-center">
    <div class="max-w-5xl mx-auto px-4">
      <p class="text-red-500 font-medium tracking-widest uppercase text-sm mb-4">{hero.eyebrow}</p>
      <h1 class="text-4xl sm:text-6xl font-bold mb-6">{hero.titlePrefix}<span class="text-red-500">{hero.titleHighlight}</span></h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">{hero.subtitle}</p>
    </div>
  </section>
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12"><h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Les bienfaits du <span class="text-red-600">Karaté Santé</span></h2><div class="w-20 h-1 bg-red-600 mx-auto"></div></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {benefits.map((benefit) => <div class="bg-gray-50 rounded-xl p-8 text-center"><div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-5"><Icon name={benefit.icon} class="w-7 h-7 text-red-600" /></div><h2 class="text-xl font-bold text-gray-900 mb-3">{benefit.title}</h2><p class="text-gray-600 leading-relaxed">{benefit.text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12"><h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Informations <span class="text-red-600">pratiques</span></h2><div class="w-20 h-1 bg-red-600 mx-auto"></div></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-xl p-6 shadow-sm"><Icon name="lucide:calendar-days" class="w-6 h-6 text-red-600 mb-4" /><p class="text-sm text-gray-500">Quand ?</p><p class="font-semibold text-gray-900">{details.day}</p><p class="text-gray-600">{details.time}</p></div>
        <div class="bg-white rounded-xl p-6 shadow-sm"><Icon name="lucide:map-pin" class="w-6 h-6 text-red-600 mb-4" /><p class="text-sm text-gray-500">Où ?</p><p class="font-semibold text-gray-900">{details.location}</p><p class="text-gray-600">{details.address}</p></div>
        <div class="bg-white rounded-xl p-6 shadow-sm"><Icon name="lucide:sparkles" class="w-6 h-6 text-red-600 mb-4" /><p class="text-sm text-gray-500">Découverte</p><p class="font-semibold text-gray-900">{details.trial}</p></div>
        <div class="bg-white rounded-xl p-6 shadow-sm"><Icon name="lucide:user-round" class="w-6 h-6 text-red-600 mb-4" /><p class="text-sm text-gray-500">Professeur</p><p class="font-semibold text-gray-900">{teacher.name}</p><p class="text-gray-600">{teacher.grade}</p></div>
      </div>
    </div>
  </section>
  <section class="py-16 bg-white text-center">
    <img
        src="/images/Sport-Sante-Bretagne-Forme-Sante-Logo.png"
        alt=""
        loading="lazy"
        style="width: 200px"
        class="inline-flex items-center"
    />
    <img
        src="/images/FFKarate_H_COULEUR_PRINT.png"
        alt=""
        style="width: 200px"
        loading="lazy"
        class="inline-flex items-center"
    />
  </section>
  <section class="bg-gray-900 text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4"><h2 class="text-3xl font-bold mb-4">{cta.title}</h2><p class="text-gray-300 mb-8">{cta.text}</p>
      <a href={`${base}#contact`} class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-semibold px-8 py-3 rounded">{cta.primaryLabel}<Icon name="lucide:arrow-right" class="w-4 h-4" /></a>
    </div>
  </section>
</div>
